# DocuMind AI — Backend Environment Variables
# Copy this file to .env and fill in values as needed.

# Optional: path to tesseract binary if not on PATH
# TESSERACT_CMD=/usr/local/bin/tesseract

# Optional: Hugging Face cache directory
# TRANSFORMERS_CACHE=/tmp/hf_cache

# Optional: set to "cpu" to force CPU inference (default auto-detects GPU)
# TORCH_DEVICE=cpu

# CORS origin for frontend (default: http://localhost:5173)
# FRONTEND_ORIGIN=http://localhost:5173
